# Auth.js
AUTH_SECRET=
# Public site URL (recommended in production)
AUTH_URL=https://docs.premierplanner.eu

# ── Authentik OIDC (primary) ─────────────────────────────
# Issuer = Authentik OpenID provider URL (ends with /application/o/<slug>/)
# Homelab SSO host: https://auth.zvapor.xyz
AUTHENTIK_ISSUER=https://auth.zvapor.xyz/application/o/premier-docs/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Claim(s) that carry group/role names (comma-separated). Defaults work for Authentik.
AUTHENTIK_ROLE_CLAIM=groups,roles

# Map Authentik group names → docs roles (comma-separated, case-insensitive).
# Defaults if unset: docs-admin / docs-editor / docs-viewer
# (+ premier-docs-* aliases)
AUTHENTIK_ADMIN_GROUPS=docs-admin,premier-docs-admin
AUTHENTIK_EDITOR_GROUPS=docs-editor,premier-docs-editor
AUTHENTIK_VIEWER_GROUPS=docs-viewer,premier-docs-viewer

# ── Optional local credentials fallback ──────────────────
# Set to "true" only for break-glass / local-dev without Authentik.
AUTH_CREDENTIALS_ENABLED=false
EDITOR_USERNAME=
EDITOR_PASSWORD=

# ── Editor saves via GitHub (required on Vercel) ─────────
# Vercel's filesystem is read-only, so the editor commits pages to GitHub and the
# commit redeploys the site. Leave the token empty for local dev (saves to disk).
# Fine-grained PAT, only this repo, Contents: read and write.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=Vapor-Productions/premier-docs-next
GITHUB_CONTENT_BRANCH=main
